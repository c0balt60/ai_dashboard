# Copy to key.properties (git ignores it) and fill in, to sign release builds.
# Create the keystore once (keytool is in your JDK's bin folder) with:
#   keytool -genkey -v -keystore C:/Users/you/keys/ai_dashboard.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# The keystore uses one password for both entries below. Use forward slashes
# in storeFile: a backslash is an escape character in .properties files.
# CI signs with the same key from the ANDROID_* repository secrets, so keep a
# backup: an app signed with a lost key can never be updated, only reinstalled.
storePassword=
keyPassword=
keyAlias=upload
storeFile=C:/Users/you/keys/ai_dashboard.jks
